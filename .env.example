# Backend base URL, including the /api prefix the NestJS app sets globally.
# This is the API, not this site — it does not change when the site moves.
# Local backend: http://localhost:3000/api
NEXT_PUBLIC_API_URL=https://backend-v2-gwuz.onrender.com/api

# This site's own public origin, no trailing slash. Used as `metadataBase` so
# Open Graph and canonical URLs resolve absolutely — a WhatsApp or Twitter
# link preview needs a full URL, and a relative one silently yields no image.
#
# NOTE the `www.`: https://crowdpazz.com 308-redirects to
# https://www.crowdpazz.com, so `www` is the canonical origin. It must match
# the backend's CORS_ORIGINS/APP_URL exactly, or the checkout returnUrl is
# rejected and buyers land on the API's mobile callback page instead of here.
NEXT_PUBLIC_SITE_URL=https://www.crowdpazz.com

# IPFS gateway for event covers. Covers are pinned via Pinata but the URL
# stored on the event points at ipfs.io, which 504s for CrowdPass CIDs.
# Prefer a dedicated Pinata gateway (<name>.mypinata.cloud) for production —
# the shared public one is rate-limited. Set to "" to disable rewriting.
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud/ipfs
